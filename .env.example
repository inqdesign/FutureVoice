# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ElevenLabs — voice cloning + fluent-self TTS
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Anthropic Claude — conversation, pattern detection, rephrasing
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI Whisper — STT fallback (optional in Phase 1)
OPENAI_API_KEY=

# Supabase — auth, learner profile, session storage (Phase 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
