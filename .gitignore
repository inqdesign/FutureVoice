# Swift Package Manager
.swiftpm/
.build/
Package.resolved

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Logs
*.log

# Audio cache (local recordings during dev)
Recordings/
*.wav
# …except the Android ringtone. It is a BUNDLE RESOURCE by necessity: on
# iOS 26 a sound written at runtime is silently ignored by AlarmKit and
# UNNotificationSound, and Android's notification channel likewise needs a
# real `R.raw` entry. `DailyCall.kt` references `R.raw.ringtone` by name, so
# without this the Android app does not even COMPILE from a fresh clone.
!android/app/src/main/res/raw/ringtone.wav
*.m4a
*.mp3
!FutureVoice/Resources/**/*.mp3
!FutureVoice/Resources/**/*.wav

# Misc
*.swp
*.bak

# fastlane — never commit the ASC API key or run artifacts
fastlane/AuthKey*.p8
fastlane/report.xml
fastlane/Preview.html
fastlane/README.md
fastlane/screenshots/_raw/

# Nested git worktrees (parallel version development)
.worktrees/

# Android (android/) — Gradle
android/local.properties
android/.gradle/
android/.kotlin/
android/captures/
.cxx/

# Release build output (xcodebuild -derivedDataPath)
build-release/

# Admin console build output — contains real user emails and personal intros.
scripts/admin/build/

# Python bytecode (scripts/admin)
__pycache__/
*.pyc

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# Screen-capture output (`-capture …` renders, hundreds of MB of simulator builds)
build-capture/

# App Store review dumps (scripts/admin) — data pulls, not source
reviews_full.json
