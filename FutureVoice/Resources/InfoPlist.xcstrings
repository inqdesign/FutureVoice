    "NSAlarmKitUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana plant deinen täglichen Anruf als Wecker, damit dein fließendes Ich dich zur gewählten Zeit erreicht — auch wenn das Telefon stumm ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana programa la llamada diaria como una alarma, para que tu yo fluido pueda contactarte a la hora fijada incluso en modo silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana programme l’appel quotidien comme une alarme, pour que ton moi fluide puisse t’appeler à l’heure prévue, même en mode silencieux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawanaは毎日の電話をアラームとして予約し、マナーモードでも流暢な自分が決まった時刻に連絡できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나와나는 매일 전화를 알람으로 예약해, 무음 모드에서도 유창한 내가 정해진 시각에 연락할 수 있게 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana 会把每日来电排成闹钟，让流利的自己在静音模式下也能准时联系你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana 會把每日來電排成鬧鐘，讓流利的自己在靜音模式下也能準時聯絡你。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana fotografiert den Ort, an dem du heute gelernt hast, für die Karte des Tages."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "nawana takes a photo of where you studied, for today's card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana toma una foto del lugar donde estudiaste, para la tarjeta de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana prend une photo du lieu où tu as étudié, pour la carte du jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawanaが、今日勉強した場所を撮影して今日のカードに使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나와나가 오늘 공부한 자리를 찍어 오늘의 카드에 씁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana 会拍下今天读书的地方，用在今日卡片上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana 會拍下今天讀書的地方，用在今日卡片上。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "nawana nimmt deine Stimme auf, um sie zu klonen und dich in einer anderen Sprache fließend sprechen zu hören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "nawana records your voice so it can clone it and let you hear yourself speaking fluently in another language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana graba tu voz para clonarla y que puedas oírte hablando otro idioma con fluidez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana enregistre ta voix pour la cloner et te faire entendre parler une autre langue avec fluidité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawanaが声を録音してクローンを作り、別の言語を流暢に話す自分の声を聞かせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "나와나가 목소리를 녹음해 클론을 만들고, 다른 언어를 유창하게 말하는 내 목소리를 들려줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana 会录下你的声音来克隆，让你听见自己流利说另一种语言的样子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana 會錄下你的聲音來複製，讓你聽見自己流利說另一種語言的樣子。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "nawana transkribiert deine Sprache auf dem Gerät, um sie mit der fließenden Version deiner Stimme zu vergleichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "nawana transcribes what you say on-device so it can compare your speech with the fluent version of your voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana transcribe en el dispositivo lo que dices, para comparar tu habla con la versión fluida de tu voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana transcrit sur l’appareil ce que tu dis, pour comparer ta parole avec la version fluide de ta voix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawanaが話した内容を端末内で文字に起こし、流暢な自分の声と比べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "나와나가 말한 내용을 기기 안에서 텍스트로 옮겨, 유창한 내 목소리와 비교합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana 会在设备上把你说的话转成文本，用来和流利版本的声音比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana 會在裝置上把你說的話轉成文字，用來和流利版本的聲音比較。"
          }
        }
      }
