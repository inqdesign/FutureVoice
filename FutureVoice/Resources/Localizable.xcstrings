    "Past tense slipped twice once the story moved back in time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al irse la historia al pasado, el pasado se te torció dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand l’histoire est repartie dans le passé, le passé a flanché deux fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昔の話に移ったところで、過去形が2回ぶれました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난 일로 넘어가면서 과거형이 두 번 흔들렸어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一讲到以前的事，过去式就漏了两次。"
