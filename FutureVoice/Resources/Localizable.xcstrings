          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 모델은 비밀번호와는 차원이 다른 개인정보예요. 내 모델이 어떻게 쓰이고 어디에 남는지 그대로 알려드릴게요."
          }
        }
      }
    },
