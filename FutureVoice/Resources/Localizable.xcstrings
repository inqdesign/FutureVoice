    "Watch uses this text — edit it freely." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch verwendet diesen Text — bearbeite ihn frei."
