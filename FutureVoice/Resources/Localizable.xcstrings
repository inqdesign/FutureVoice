    "Today is %lld min — %lld from your plan plus %lld you didn't use." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Today is %1$lld min — %2$lld from your plan plus %3$lld you didn't use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy tienes %1$lld min: %2$lld de tu plan más %3$lld que no usaste."
          }
        },
        "fr" : {
          "stringUnit" : {
