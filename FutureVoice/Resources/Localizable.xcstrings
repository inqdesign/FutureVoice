        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プールに登録されました。ほかの%@の学習者が、このペルソナを見つけて話せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풀에 등록됐어요 — 다른 %@ 학습자들이 내 페르소나를 찾아 대화할 수 있어요."
