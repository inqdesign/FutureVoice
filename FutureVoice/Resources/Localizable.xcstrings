    "Days you skip aren't lost — up to %lld days of unused minutes come back with tomorrow's." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días que no usas no se pierden — hasta %lld días de minutos sin gastar vuelven con los de mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours sautés ne sont pas perdus — jusqu’à %lld jours de minutes non utilisées reviennent avec celles de demain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使わなかった日も無駄になりません。最大%lld日分が明日の分に上乗せされて戻ってきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안 쓴 날은 사라지지 않아요. 최대 %lld일치가 내일 몫에 얹혀서 돌아와요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没用的日子不会浪费。最多%lld天的份会加到明天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒用的日子不會浪費。最多%lld天的份會加到明天。"
          }
        }
      }
    },
    "Days you skip aren't lost — your minutes stay yours for %lld days." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días que no usas no se pierden — tus minutos siguen siendo tuyos durante %lld días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours sautés ne sont pas perdus — tes minutes te restent pendant %lld jours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使わなかった日も無駄になりません。%lld日間はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안 쓴 날은 사라지지 않아요. %lld일 동안은 그대로 남아 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没用的日子不会浪费。%lld天内都还在。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒用的日子不會浪費。%lld天內都還在。"
          }
        }
      }
    },
