    "A code counts once per account, so this one is done." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada código vale una vez por cuenta, así que con este ya está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un code compte une fois par compte, donc c’est fini pour celui-là."
          }
        },
        "ja" : {
