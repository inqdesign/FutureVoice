        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상황연습은 길이와 상관없이 한 번으로 계산되고, 매일 다시 채워져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
