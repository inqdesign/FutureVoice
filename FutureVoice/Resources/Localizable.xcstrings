    "Finish a conversation, then come back to shadow any line your fluent self said." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende ein Gespräch und komm zurück, um jeden Satz deines fließenden Ichs nachzusprechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina una llamada y vuelve para hacer shadowing de cualquier frase que dijo tu yo fluido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine un appel, puis reviens faire du shadowing sur n’importe quelle phrase de ton moi fluide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話を一度終えると、流暢な自分が話した文からどれでも選んでシャドーイングできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화를 한 번 마치면, 유창해진 내가 한 말 중에 아무 문장이나 골라 따라 말할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先完成一次对话，再回来跟读流利的自己说过的任何一句。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先完成一次對話，再回來跟讀流利的自己說過的任何一句。"
          }
        }
      }
    },
