    "Grounded in your relationship with %@ — these appear as ideas when you tap them on the Watch tab." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basiert auf deiner Beziehung zu %@ — diese erscheinen als Ideen, wenn du im Watch-Tab darauf tippst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basadas en tu relación con %@ — aparecen como ideas cuando tocas a esta persona en la pestaña Escenas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basé sur ta relation avec %@. Ces idées apparaissent quand tu touches cette personne dans l’onglet Scènes."
          }
