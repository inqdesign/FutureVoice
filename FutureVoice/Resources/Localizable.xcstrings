    "Vocabulary, fluency, grammar and expression each get their own page — swipe or tap the chips above." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocabulario, fluidez, gramática y expresión tienen su propia página — desliza o toca las pestañas de arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocabulaire, fluidité, grammaire et expression ont chacun leur page — balaie ou touche les onglets ci-dessus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語彙・流暢さ・文法・表現力にはそれぞれページがあります。上のチップをタップするか、横にスワイプしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어휘·유창성·문법·표현력은 각자 페이지가 있어요 — 위의 칩을 누르거나 옆으로 넘겨 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "词汇、流畅度、语法和表达各有自己的页面，点上面的标签或左右滑动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字彙、流暢度、文法和表達各有自己的頁面，點上面的標籤或左右滑動。"
          }
        }
      }
    },
