    "Dictation isn't available in this language on your device — you can still type." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktat ist auf deinem Gerät für diese Sprache nicht verfügbar — tippen geht weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu teléfono no dicta en este idioma — pero sí puedes escribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton téléphone ne dicte pas cette langue — mais tu peux écrire."
