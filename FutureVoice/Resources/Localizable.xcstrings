    "Shadow your fluent self's lines in your own voice. Slow it down, loop the part that trips you, until it comes out without thinking." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite las frases de tu yo fluido con tu propia voz. Más despacio, en bucle en la parte que se te traba, hasta que salga sin pensar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répète les phrases de ton moi fluide avec ta propre voix. Plus lentement, en boucle sur le passage qui coince, jusqu’à ce que ça sorte sans réfléchir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流暢な自分の声をそのまま真似して話します。ゆっくり、つまずくところだけ繰り返して、考えずに出てくるまで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유창해진 내 목소리를 그대로 따라 말해요. 느리게, 걸리는 구간만 반복해서, 생각 없이 나올 때까지요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用自己的声音跟着流利的自己说。放慢，只重复卡住的地方，练到不用想就能说出口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用自己的聲音跟著流利的自己說。放慢，只重複卡住的地方，練到不用想就能說出口。"
          }
        }
      }
    },
