    "Talks get more real when I know your life." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespräche werden echter, wenn ich dein Leben kenne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto más me cuentes de tu día a día, más reales serán las llamadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus je connais ton quotidien, plus les appels sonnent vrai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常を教えてもらうほど、会話が本物に近づきます。"
