    "Words per minute of voiced speech — pauses and think-time don't drag it down." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palabras por minuto contando solo el tiempo en que suena tu voz: las pausas para pensar no cuentan."
          }
        },
        "fr" : {
          "stringUnit" : {
