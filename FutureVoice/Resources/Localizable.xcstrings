        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes personnes, plus celles que tu as mises en favori depuis la page Personnes. Parler avec quelqu’un ne l’ajoute pas ici — mets-le en favori pour le garder."
          }
