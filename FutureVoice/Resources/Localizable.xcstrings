        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次發言平均%lld個字。除了發生了什麼，也說說當時的感覺。"
          }
        }
      }
    },
    "Your voice is handled with care." : {
