          }
        }
      }
    },
    "Everything you've collected, whenever you want to browse it. Today's practice is on the Practice tab." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was du gesammelt hast — zum Stöbern, wann immer du willst. Die heutige Übung steht im Übungs-Tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que has reunido, para verlo cuando quieras. La práctica de hoy está en la pestaña Práctica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que tu as réuni, à parcourir quand tu veux. La pratique du jour est dans l’onglet Pratique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これまで集めたものすべて。いつでも見返せます。今日の練習は練習タブにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금까지 모은 것 전부 — 언제든 둘러보세요. 오늘 할 연습은 연습 탭에 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到目前为止收集的一切，随时翻翻。今天要做的练习在练习页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
