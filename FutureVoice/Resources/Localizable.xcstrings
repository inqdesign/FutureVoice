        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상황연습을 준비하는 중…"
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정"
          }
