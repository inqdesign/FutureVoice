    "Add someone from your real life — their cloned voice can act out any scenario you build." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge jemanden aus deinem echten Leben hinzu — die geklonte Stimme spielt jede Situation, die du baust."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際に知っている人を追加してみてください。その人の声でどんなシチュエーションでも演じてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제로 아는 사람을 추가해 보세요. 그 사람 목소리로 어떤 상황이든 연기해 줘요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入你真實生活中的人。用那個人的聲音，任何情境都能演出來。"
          }
        }
      }
    },
