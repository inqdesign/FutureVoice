    "Replaces your current voice. Your recording is kept, so you can rebuild the original anytime from Me → Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt deine aktuelle Stimme. Deine Aufnahme bleibt erhalten — du kannst das Original jederzeit unter Me → Voice neu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye tu voz actual. Tu grabación se conserva, así que puedes volver a crear la original cuando quieras en Mi perfil → Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace ta voix actuelle. Ton enregistrement est conservé, donc tu peux refaire l’originale à tout moment dans Mon profil → Voix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の声をこれに置き換えます。録音はそのまま残るので、マイページ → 声からいつでも元に戻せます。"
