    "Watch the scene, study its words and expressions, shadow your lines, then Talk it live." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir die Szene an, lerne ihre Wörter und Wendungen, sprich deine Sätze nach und führ es dann live als Gespräch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira la escena, estudia sus palabras y expresiones, haz shadowing de tus frases y luego habla en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde la scène, apprends ses mots et ses expressions, fais le shadowing de tes phrases, puis parle en direct."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン練習を見て、出てきた単語と表現を学び、自分のセリフをシャドーイングしてから、実際に話してみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상황연습을 보고, 거기 나온 단어와 표현을 익히고, 내 대사를 섀도잉한 다음, 실제로 대화해 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看情境练习，学里面的单词和用语，跟读自己的台词，然后实际对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看情境練習，學裡面的單字和用語，跟讀自己的台詞，然後實際對話。"
          }
        }
      }
    },
