    },
    "The name other learners will see — first name or nickname is plenty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name, den andere Lernende sehen — Vorname oder Spitzname reicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre que verán otras personas — con tu nombre o un apodo basta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom que les autres verront — un prénom ou un pseudo suffit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの学習者に見える名前です。名前かニックネームで十分です。"
