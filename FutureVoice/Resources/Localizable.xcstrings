        }
      }
    },
    "The more you say it,\nthe more it's yours" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto más lo dices,\nmás tuyo es"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus tu le dis,\nplus c’est à toi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話すほど、\n自分のものになる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말할수록,\n내 것이 된다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越说，\n越是自己的"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越說，\n越是自己的"
          }
        }
      }
    },
    "The more you share, the more I'll sound like a version of you — not a textbook." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mehr du erzählst, desto mehr klinge ich nach einer Version von dir — nicht nach einem Lehrbuch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto más me cuentes, más hablaré como una versión de ti, y menos como un libro de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus tu m’en dis, plus je parlerai comme une version de toi — pas comme un manuel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たくさん教えてくれるほど、教科書の例文じゃなくて君らしく話せるようになるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "많이 알려줄수록 교과서 예문이 아니라 너처럼 말하게 돼."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你告诉我越多，我就越会像你那样说话，而不是像课本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你告訴我越多，我就越會像你那樣說話，而不是像課本。"
          }
        }
      }
    },
    "The more you speak,\nthe more it stacks" : {
      "extractionState" : "stale",
      "localizations" : {
