            "value": "Die Szene zu dieser Situation wird geschrieben…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 상황의 장면을 쓰는 중…"
          }
        }
      }
    },
    "Writing this scene…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Szene wird geschrieben…"
          }
