    },
    "Your voice is ready — sign in to keep it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声の準備ができました。ログインすると使い続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
