    "Today's news, a situation you're walking into this week, or nothing in particular. One tap, like placing a call." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las noticias de hoy, una situación que te espera esta semana o nada en concreto. Un toque, como marcar un número."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actus du jour, une situation qui t’attend cette semaine, ou rien de particulier. Un seul toucher, comme passer un appel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のニュース、今週ありそうな状況、なんでもない話でも。電話をかけるように、タップ一回で始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 뉴스, 이번 주에 겪을 상황, 아무 얘기나요. 전화 걸듯 탭 한 번이면 시작해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的新闻、这周会遇到的情况，或什么都不特别聊。像打电话一样，点击就开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的新聞、這週會遇到的情況，或什麼都不特別聊。像打電話一樣，點一下就開始。"
          }
        }
      }
    },
