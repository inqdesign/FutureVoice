    "Your pace is %lld words/min — talk more often and a little longer; longer turns build flow." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ritmo es de %lld palabras por minuto. Habla más a menudo y un poco más largo: los turnos largos crean fluidez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton rythme est de %lld mots/min — parle plus souvent et un peu plus longtemps ; les longues prises de parole installent la fluidité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話す速さは1分あたり%lld語です。もっと頻繁に、少し長く話すと流れがつきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말하기 속도가 분당 %lld단어예요. 더 자주, 조금 더 길게 말하면 흐름이 붙어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说话速度是每分钟%lld个字。更常说、说久一点，流畅度就会上来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說話速度是每分鐘%lld個字。更常說、說久一點，流暢度就會上來。"
          }
        }
      }
    },
