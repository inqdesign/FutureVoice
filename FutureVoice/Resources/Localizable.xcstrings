    "Session scorecards, weekly reports, and the daily call are on the house." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puntuación de cada llamada, el informe semanal y la llamada diaria son gratis."
