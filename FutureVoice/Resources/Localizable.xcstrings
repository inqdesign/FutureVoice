    "People we invented to practice with — different jobs, places and ways of talking." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfundene Leute zum Üben — verschiedene Berufe, Orte und Sprechweisen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personas que inventamos para practicar: cada una con su trabajo, su lugar y su forma de hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des personnes qu’on a inventées pour s’entraîner — chacune avec son métier, son coin et sa façon de parler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習用に作った架空の人たちです。仕事も、住む場所も、話し方もそれぞれ違います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습용으로 만든 가상의 사람들이에요 — 직업도, 사는 곳도, 말투도 제각각이에요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是我们虚构的练习对象，职业、住的地方和说话方式各不相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些是我們虛構的練習對象，職業、住的地方和說話方式各不相同。"
          }
        }
      }
    },
    "People we invented to practice with — each one in the middle of something they'll want to talk about." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfundene Leute zum Üben — jede und jeder steckt gerade mitten in etwas, worüber sie reden wollen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personas que inventamos para practicar: cada una en medio de algo de lo que querrá hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des personnes qu’on a inventées pour s’entraîner — chacune en plein milieu de quelque chose dont elle voudra parler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習用に作った人たちです。みんな今なにかの真っただ中にいて、話したいことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습용으로 만든 사람들이에요 — 모두 지금 무언가의 한가운데에 있어서, 하고 싶은 이야기가 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是我们虚构的练习对象，每个人都正在经历些什么，有想聊的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些是我們虛構的練習對象，每個人都正在經歷些什麼，有想聊的事。"
          }
        }
      }
    },
