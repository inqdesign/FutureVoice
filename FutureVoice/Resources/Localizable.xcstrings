    "Shadow the exact lines in your own voice, at any speed, until they stick." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite con tu propia voz, cambiando la velocidad, hasta que se te quede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répète avec ta propre voix en changeant la vitesse, jusqu’à ce que ça reste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "速度を変えながら、自分の声で真似して読みます。口になじむまで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "속도를 바꿔가며 내 목소리로 따라 읽어요. 입에 붙을 때까지요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用自己的声音跟读，速度随你调，练到顺口为止。"
          }
        },
        "zh-Hant" : {
