    "Your turns average %lld words — add detail: how things felt, not just what happened." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus turnos son de %lld palabras de media. Añade detalle: no solo qué pasó, también cómo te sentiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dis %lld mots en moyenne par prise de parole — ajoute du détail : pas seulement ce qui s’est passé, aussi ce que tu as ressenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回に話す長さは平均%lld語です。何があったかに加えて、どう感じたかも話してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 말할 때 평균 %lld단어예요. 무슨 일이 있었는지에 더해 어떤 기분이었는지도 말해 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次发言平均%lld个字。除了发生了什么，也说说当时的感觉。"
