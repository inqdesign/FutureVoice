    },
    "Your recent conversations measure at a higher level. Scoring and material difficulty now follow it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzten Gespräche wurden auf einem höheren Niveau eingestuft. Bewertung und Materialschwierigkeit richten sich jetzt danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus conversaciones recientes se miden en un nivel más alto. La puntuación y la dificultad del material ya lo siguen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes conversations récentes se mesurent à un niveau plus haut. La notation et la difficulté du matériel le suivent désormais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近の会話が、より高いレベルと測定されました。採点と教材の難しさは、これから新しいレベルに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 대화가 더 높은 레벨로 측정됐어요. 이제 채점과 학습 자료 난이도가 새 레벨을 따라가요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近的对话测出了更高的水平。评分和教材难度现在会跟着新水平走。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近的對話測出了更高的程度。評分和教材難度現在會跟著新程度走。"
          }
        }
      }
    },
    "Your recording is sent to ElevenLabs, which builds a voice model from it. That model is biometric data." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
