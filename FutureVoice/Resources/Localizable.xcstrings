    "Something specific coming up with them — a talk you're dreading, news you have to break." : {
      "comment" : "Tooltip text for the \"Make a situation\" button on the FindPersonCard.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas Konkretes, das mit ihnen ansteht — ein Gespräch, vor dem dir graut, eine Nachricht, die du überbringen musst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo concreto que tienes por delante con esa persona: una conversación que temes, una noticia que tienes que dar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose de précis qui t’attend avec cette personne — une discussion que tu redoutes, une nouvelle à annoncer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その人と控えている具体的なこと。切り出しにくい話、伝えなければならない知らせ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 사람과 앞두고 있는 구체적인 일 — 꺼내기 어려운 이야기, 전해야 하는 소식."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和对方即将发生的具体事情：不知道怎么开口的话、必须告知的消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和對方即將發生的具體事情：不知道怎麼開口的話、必須告知的消息。"
          }
        }
      }
    },
