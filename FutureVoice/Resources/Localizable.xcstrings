    "You and your friend each get 300 credits when they join with your code — for up to 10 friends." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du und dein Freund bekommt je 300 Credits, wenn er mit deinem Code beitritt — für bis zu 10 Freunde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un amigo se registra con tu código, cada uno recibe 300 créditos. Hasta 10 amigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ami s’inscrit avec ton code : 300 crédits pour lui, 300 pour toi. Jusqu’à 10 amis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちがこのコードで登録すると、ふたりとも300クレジットもらえます。最大10人までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구가 내 코드로 가입하면 둘 다 300 크레딧을 받아요. 최대 10명까지요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友用你的邀请码加入，两人各拿到300点数。最多10位朋友。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友用你的邀請碼加入，兩人各拿到300點數。最多10位朋友。"
          }
        }
      }
    },
    "You and your friend each get about an hour of talk time when they join with your code — for up to 10 friends." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr bekommt beide rund eine Stunde Sprechzeit, wenn jemand mit deinem Code beitritt — für bis zu 10 Personen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un amigo se registra con tu código, cada uno recibe cerca de una hora de tiempo de conversación. Hasta 10 amigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ami s’inscrit avec ton code : environ une heure de conversation pour lui, autant pour toi. Jusqu’à 10 amis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちがこのコードで登録すると、ふたりとも通話時間が約1時間ずつもらえます。最大10人までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구가 내 코드로 가입하면 둘 다 통화 시간을 약 1시간씩 받아요 — 최대 10명까지."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友用你的邀请码加入，两人各拿到约1小时的通话时间。最多10位朋友。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
