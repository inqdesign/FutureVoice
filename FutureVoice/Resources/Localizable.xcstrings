    "Master every word and line in a book — from a talk or a scene — and it lands here for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beherrsche jedes Wort und jeden Satz eines Buchs — aus einem Gespräch oder einer Szene — und es landet dauerhaft hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domina todas las palabras y frases de un cuaderno — de una llamada o de una escena — y se queda aquí para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maîtrise tous les mots et toutes les phrases d’un carnet — d’un appel ou d’une scène — et il reste ici pour de bon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話からでもシーン練習からでも、ブックの単語と文をすべて覚えると、ここにずっと残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화에서 왔든 상황연습에서 왔든, 책 안의 단어와 문장을 전부 익히면 여기 영영 남아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不论来自通话还是情境练习，把复习本里的单词和句子全部学会，就会永远留在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不論來自通話還是情境練習，把複習本裡的單字和句子全部學會，就會永遠留在這裡。"
          }
        }
      }
    },
