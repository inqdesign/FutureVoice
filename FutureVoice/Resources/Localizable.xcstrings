    "I'm practicing speaking with my own AI voice on nawana. Enter my code %@ when you sign up and we both get %lld minutes of talk time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I'm practicing speaking with my own AI voice on nawana. Enter my code %1$@ when you sign up and we both get %2$lld minutes of talk time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoy practicando cómo hablar con mi propia voz de IA en nawana. Escribe mi código %1$@ al registrarte y los dos recibimos %2$lld minutos de conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je m’entraîne à parler avec ma propre voix IA sur nawana. Saisis mon code %1$@ à l’inscription et on reçoit chacun %2$lld minutes de conversation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawanaで自分の声を使って話す練習をしています。登録するときにコード%1$@を入力すると、ふたりとも通話時間が%2$lld分もらえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana에서 내 목소리로 말하기 연습하고 있어요. 가입할 때 코드 %@ 를 넣으면 둘 다 통화 %lld분을 받아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我在nawana用自己的AI声音练口语。注册时输入我的邀请码%1$@，我们两个都能拿到%2$lld分钟通话时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我在nawana用自己的AI聲音練習口說。註冊時輸入我的邀請碼%1$@，我們兩個都能拿到%2$lld分鐘通話時間。"
          }
        }
      }
    },
