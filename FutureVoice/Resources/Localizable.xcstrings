    "Scored against your %@ level setting — how this talk went, not a level rating." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewertet gegen deine Niveau-Einstellung %@ — wie dieses Gespräch lief, keine Niveau-Einstufung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntuada según tu nivel %@. No es una evaluación de nivel: muestra cómo fue esta llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noté par rapport à ton niveau %@. Ce n’est pas une évaluation de niveau : ça montre comment cet appel s’est passé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@レベルの設定を基準にしたスコアです。レベル判定ではなく、この通話がどうだったかを示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 레벨 설정을 기준으로 매긴 점수예요. 레벨 판정이 아니라 이번 대화가 어땠는지를 보여줘요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以%@等级设置为基准的分数。不是等级判定，而是这次通话表现如何。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以%@等級設定為基準的分數。不是等級判定，而是這次通話表現如何。"
          }
        }
      }
    },
