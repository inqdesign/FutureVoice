    },
    "The avatar will play this role. You practice your side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Avatar spielt diese Rolle. Du übst deine Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El avatar hará este papel. Tú practicas tu parte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’avatar jouera ce rôle. Toi, tu t’entraînes de ton côté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アバターがこの役を演じます。自分は自分の側を練習します。"
          }
