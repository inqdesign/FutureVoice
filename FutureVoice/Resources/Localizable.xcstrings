    "Your persona plays this scene in their own voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Persona spielt diese Szene mit ihrer eigenen Stimme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu personaje actúa esta escena con su propia voz."
          }
        },
        "fr" : {
          "stringUnit" : {
