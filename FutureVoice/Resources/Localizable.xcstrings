        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末はこの言語の音声入力に対応していません。タイピングはできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 이 언어를 받아쓰지 못해요. 타이핑은 돼요."
