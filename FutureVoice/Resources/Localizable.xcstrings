        }
      }
    },
    "Assessed %@ — a while back. Your next talks feed a fresh assessment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingestuft %@ — schon eine Weile her. Deine nächsten Gespräche fließen in eine neue Einstufung ein."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に判定しました。だいぶ前ですね。これからの通話が新しい判定に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 평가했어요 — 꽤 지났네요. 다음 대화들이 새 평가에 반영돼요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在%@評估過，已經有一陣子了。接下來的通話會用來重新評估。"
          }
        }
      }
    },
    "Assessed %@ from your recent talk — vocabulary, grammar, fluency and expression together." : {
      "localizations" : {
