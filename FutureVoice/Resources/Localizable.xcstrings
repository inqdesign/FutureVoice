    "As long as you need, as often as you need — work, family, a move abroad, an exam." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el tiempo que necesites, tan a menudo como quieras — trabajo, familia, una mudanza al extranjero, un examen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aussi longtemps qu’il te faut, aussi souvent qu’il te faut — le travail, la famille, un départ à l’étranger, un examen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なだけ長く、必要なだけ何度でも。仕事、家族、海外への引っ越し、試験。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 만큼 길게, 필요한 만큼 자주 — 일, 가족, 이주, 시험."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要多久就多久，要多常就多常。工作、家人、搬到国外、考试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要多久就多久，要多常就多常。工作、家人、搬到國外、考試。"
          }
        }
      }
    },
    "As much as you want, whenever you want" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que quieras, sin límite"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autant que tu veux, sans limite"
