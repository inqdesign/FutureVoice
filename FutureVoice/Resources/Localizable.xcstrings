    },
    "Your fluent self speaks this language in your own voice. You can add more languages later — same voice, no extra setup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein fließendes Ich spricht diese Sprache in deiner eigenen Stimme. Weitere Sprachen kannst du später hinzufügen — gleiche Stimme, kein zusätzliches Setup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu yo fluido habla este idioma con tu propia voz. Después puedes añadir más idiomas: la misma voz, sin volver a configurar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton moi fluide parle cette langue avec ta propre voix. Tu pourras ajouter d’autres langues plus tard — même voix, rien à reconfigurer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流暢な自分が、この言語を自分の声で話します。あとで言語を追加しても声はそのままなので、録音し直す必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유창해진 내가 이 언어를 내 목소리로 말해요. 나중에 언어를 더 추가해도 목소리는 그대로라, 다시 녹음할 필요 없고요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流利的自己会用你的声音说这个语言。之后再加其他语言，声音也一样，不用重新录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流利的自己會用你的聲音說這個語言。之後再加其他語言，聲音也一樣，不用重新錄。"
          }
        }
      }
    },
    "Your fluent self used this — you didn't." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto lo usó tu yo fluido; tú todavía no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est ton moi fluide qui l’a utilisé ; toi, pas encore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流暢な自分が使った表現です。自分はまだ使っていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유창해진 내가 쓴 표현이에요. 나는 아직 안 썼고요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是流利的自己用过的用语，你还没用过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是流利的自己用過的用語，你還沒用過。"
          }
        }
      }
    },
    "Your fluent self wants to know you" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein fließendes Ich möchte dich kennenlernen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo conociéndote puede hablar como tú"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il doit te connaître pour parler comme toi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分を知ってこそ、自分らしく話せます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나를 알아야 나처럼 말해요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要先认识你，才说得像你"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要先認識你，才說得像你"
          }
        }
      }
    },
    "Your free trial ends soon" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba gratis termina pronto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton essai gratuit se termine bientôt"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料トライアルがもうすぐ終わります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 체험이 곧 끝나요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费试用快结束了"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
