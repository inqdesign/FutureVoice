          }
        }
      }
    },
    "Every measured skill already reads at %@ or above — keep talking and the pooled read will catch up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo medido ya está en %@ o por encima — sigue hablando y la nota global también llegará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui est mesuré est déjà à %@ ou au-dessus. Continue à parler et la note globale suivra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測定した項目はすべて%@以上です。話し続ければ総合評価も追いつきます。"
