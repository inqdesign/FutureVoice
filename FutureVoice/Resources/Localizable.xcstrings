    "Effortless and nuanced, close to native." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mühelos und nuanciert, nahe an Muttersprache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablas sin esfuerzo y con matices, casi como un nativo."
