    "Required. Everything below is optional but the more you fill in, the more the simulated dialogues feel like the real person." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pflichtfeld. Alles darunter ist optional — aber je mehr du ausfüllst, desto echter wirken die simulierten Dialoge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obligatorio. Lo de abajo es opcional, pero cuanto más completes, más se parecerán los diálogos a la persona real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obligatoire. Le reste est facultatif, mais plus tu remplis, plus les dialogues ressemblent à la vraie personne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必須項目です。以下は任意ですが、埋めるほど会話がその人らしくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필수 항목이에요. 아래는 선택이지만, 채울수록 대화가 그 사람처럼 느껴져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必填。下面的都是选填，但填得越多，对话就越像那个人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必填。下面的都是選填，但填得越多，對話就越像那個人。"
          }
        }
      }
    },
