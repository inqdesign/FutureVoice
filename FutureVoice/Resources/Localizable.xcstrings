        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱已生效。Apple 確認付款後，點數就會進到帳號。"
          }
        }
      }
    },
    "Your subscription is active. Your talk time lands on your account as soon as Apple confirms the purchase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
