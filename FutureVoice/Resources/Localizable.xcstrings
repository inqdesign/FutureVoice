      }
    },
    "On call · tap to stop" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Gespräch · tippen zum Beenden"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
