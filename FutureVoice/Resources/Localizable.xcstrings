        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 목소리를 이걸로 바꿔요. 녹음은 그대로 남아 있어서, 설정 → 목소리에서 언제든 원래대로 되돌릴 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会换掉现在的声音。录音会保留，随时可以到「我的 → 声音」换回原本的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
