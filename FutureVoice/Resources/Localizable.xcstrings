          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle %lld minutes de plus et ce niveau sera relu à partir de tout ce que tu as dit de nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あと%lld分話すと、新しく話したことをすべて集めてレベルを判定し直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld분 더 대화하면 그동안 새로 말한 걸 전부 모아 레벨을 다시 판정해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再聊%lld分钟，就会把这段时间新说的话全部拿来重新判定水平。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再聊%lld分鐘，就會把這段時間新說的話全部拿來重新判定程度。"
          }
        }
      }
    },
