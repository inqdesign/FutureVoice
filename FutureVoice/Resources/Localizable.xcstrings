    "A code counts once per account, so this one is done." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードはアカウントごとに1回なので、これで終わりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드는 계정당 한 번이라 이걸로 끝이에요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
