        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一場情境練習不論多長都只算一次，次數每天重新補滿。"
          }
        }
      }
    },
    "A seat has to be free. If all %lld are taken, you wait." : {
