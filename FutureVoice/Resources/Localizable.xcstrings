    "As long as you need, as often as you need — work, family, a move abroad, an exam." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なだけ長く、必要なだけ何度でも。仕事、家族、海外への引っ越し、試験。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 만큼 길게, 필요한 만큼 자주 — 일, 가족, 이주, 시험."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要多久就多久，要多常就多常。工作、家人、搬到國外、考試。"
          }
        }
      }
    },
    "As much as you want, whenever you want" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きなだけ、制限なく"
