    "Scenes you've already watched replay free forever and never use a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits gesehene Szenen kannst du immer kostenlos erneut abspielen — sie verbrauchen keine neue Szene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las escenas que ya viste puedes volver a verlas sin que se descuente ninguna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une scène déjà vue peut être revue autant que tu veux, sans qu’aucune scène soit décomptée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度見たシーン練習は、何度見ても回数が減りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 본 상황연습은 다시 봐도 그 수가 줄지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看过的情境练习再看几次都不会扣次数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看過的情境練習再看幾次都不會扣次數。"
          }
        }
      }
