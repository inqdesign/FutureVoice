    "Can't record now? No rush — this will wait." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade keine Aufnahme möglich? Kein Stress — das wartet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ahora no puedes grabar? Sin prisa, esto te espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne peux pas enregistrer maintenant ? Pas de presse, ça t’attend."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま録音が難しければ、あとでも大丈夫です。待っていますね。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 녹음이 어려우면 나중에 해도 돼요. 기다릴게요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在不方便录音？不急，之后再录也可以。"
