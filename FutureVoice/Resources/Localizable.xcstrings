        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒你試用期快要轉為付費。試用開始時會詢問通知權限。"
          }
        }
      }
    },
    "A scene costs one count however long it runs, and the count resets every day." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Szene zählt einmal, egal wie lang sie läuft, und die Zählung beginnt jeden Tag neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una escena cuenta como una, dure lo que dure, y la cuenta se recarga cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une scène compte pour une, quelle que soit sa durée, et le compte se recharge chaque jour."
