    },
    "Your growth curve starts at your second assessment — every assessment adds a point here, and only assessments move your level." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wachstumskurve beginnt bei der zweiten Einstufung — jede Einstufung setzt hier einen Punkt, und nur Einstufungen bewegen dein Niveau."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성장 곡선은 두 번째 평가부터 그려져요. 평가할 때마다 점이 하나씩 찍히고, 레벨은 평가로만 움직여요."
          }
        }
      }
    },
    "Your history together" : {
      "localizations" : {
        "de" : {
