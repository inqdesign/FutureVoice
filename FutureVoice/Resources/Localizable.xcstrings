    "Not their real voice — an AI speaks their words in a voice you pick." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es su voz real: una IA lee sus palabras con la voz que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas sa vraie voix : une IA lit ses mots avec la voix que tu choisis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人の声ではありません。選んだ声で、AIがこの人の言葉を読みます。"
