    },
    "Every card in today's hand is sorted. Come back tomorrow — or keep going from the library below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Karten von heute sind einsortiert. Bis morgen — oder mach unten in der Bibliothek weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya clasificaste todas las cartas de hoy. Nos vemos mañana — o sigue desde la biblioteca de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les cartes du jour sont classées. À demain — ou continue depuis la bibliothèque, plus bas."
