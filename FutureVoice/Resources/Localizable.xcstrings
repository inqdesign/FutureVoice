    "Replaces your current voice. Your recording is kept, so you can rebuild the original anytime from Me → Voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt deine aktuelle Stimme. Deine Aufnahme bleibt erhalten — du kannst das Original jederzeit unter Me → Voice neu erstellen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の声をこれに置き換えます。録音はそのまま残るので、マイページ → 声からいつでも元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 목소리를 이걸로 바꿔요. 녹음은 그대로 남아 있어서, 설정 → 목소리에서 언제든 원래대로 되돌릴 수 있어요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會換掉現在的聲音。錄音會保留，隨時可以到「我的 → 聲音」換回原本的。"
          }
        }
      }
    },
