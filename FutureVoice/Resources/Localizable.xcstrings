        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 중에는 다시 녹음해도 무료예요. 새로 만든 목소리를 선택할 때만 지금 목소리가 바뀌고요."
          }
        },
