        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유창해진 내가 쓴 표현이에요. 나는 아직 안 썼고요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是流利的自己用過的用語，你還沒用過。"
