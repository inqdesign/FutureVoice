    },
    "Talk %lld more minutes and this level gets re-read from everything new you've said.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich noch %lld Minuten, dann wird dieses Niveau aus allem Neuen neu gelesen."
