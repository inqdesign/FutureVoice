    "Your practice data stays on this device. Your voice clone and credits stay with your account." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Lerndaten bleiben auf diesem Gerät. Stimmklon und Credits bleiben bei deinem Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de práctica se quedan en este dispositivo. El clon de voz y los créditos se quedan con tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données de pratique restent sur cet appareil. Ton clone vocal et tes crédits restent liés à ton compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学習データはこの端末に残り、声のクローンとクレジットはアカウントに残ります。"
