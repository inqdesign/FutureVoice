        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我在nawana用自己的AI聲音練習口說。註冊時輸入我的邀請碼%1$@，我們兩個都能拿到%2$lld分鐘通話時間。"
          }
        }
      }
    },
