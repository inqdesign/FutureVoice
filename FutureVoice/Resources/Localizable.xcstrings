    "Worth mentioning" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué conviene escribir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qu’il vaut mieux écrire"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書いておくといいこと"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이런 걸 적으면 좋아요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以写这些"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以寫這些"
          }
        }
      }
    },
    "Write it in %@ — it's what \"you\" will talk from, and writing it is practice too. The specific beats the polished: your job, your town, the thing you'd actually talk about for an hour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib sie auf %@ — daraus spricht „dein“ Persona, und das Schreiben selbst ist Übung. Konkret schlägt poliert: dein Job, dein Ort, das Thema, über das du wirklich eine Stunde reden würdest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbelo en %@: \"tú\" hablarás a partir de esto, y escribirlo ya es práctica. Mejor concreto que pulido: tu trabajo, tu barrio, ese tema del que hablarías una hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écris-le en %@ — c’est de là que « toi » parlera, et l’écrire est déjà un entraînement. Le concret vaut mieux que le léché : ton métier, ton quartier, ce dont tu parlerais une heure sans t’arrêter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で書いてみてください。「自分」はこの紹介をもとに話しますし、書くこと自体が練習になります。きれいな文より具体的な中身を。仕事、住んでいる町、1時間でも話せるあの話題。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@로 써 보세요 — \"나\"가 이 소개를 바탕으로 말하고, 쓰는 것 자체가 연습이에요. 매끈한 문장보다 구체적인 내용이 좋아요: 하는 일, 사는 동네, 한 시간이고 떠들 수 있는 그 이야기."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用%@写。「你」会以这段介绍为底来聊，写本身也是练习。具体比漂亮重要：做什么工作、住哪里、能聊上一小时的那件事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用%@寫。「你」會以這段介紹為底來聊，寫本身也是練習。具體比漂亮重要：做什麼工作、住哪裡、能聊上一小時的那件事。"
          }
        }
      }
    },
    "Write it in %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbelo en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écris-le en %@."
