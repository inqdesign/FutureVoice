    "Talk with your fluent self like a live phone call — every reply in your cloned voice." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habla con tu yo fluido como en una llamada de verdad, en directo. Cada respuesta suena con tu voz clonada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle avec ton moi fluide comme au téléphone, en direct. Chaque réponse te revient dans ta voix clonée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流暢な自分と、本物の電話のようにリアルタイムで話します。返事はすべてクローンした自分の声で聞こえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유창해진 나와 진짜 전화처럼 실시간으로 대화해요. 대답은 전부 복제한 내 목소리로 들려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和流利的自己像讲真正的电话一样即时对话，每句回答都是你克隆的声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和流利的自己像講真正的電話一樣即時對話，每句回答都是你複製的聲音。"
          }
        }
      }
    },
