    "About five minutes a day's worth — save it up for the weekend if that's when you have time." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equivale a unos cinco minutos al día. Si tu tiempo libre está el fin de semana, júntalos y úsalos de una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’équivalent d’environ cinq minutes par jour. Si ton temps libre est le week-end, garde-les et utilise-les d’un coup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日5分ほどの量です。週末に時間があるなら、ためて一度に使っても大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 5분쯤 되는 양이에요. 주말에 시간이 난다면 모아뒀다 한 번에 써도 돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
