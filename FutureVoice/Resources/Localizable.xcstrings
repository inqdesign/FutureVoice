        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 볼 상황연습은 다 봤어요. 새 상황연습은 자정에 열리고, 이미 본 건 언제든 다시 볼 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的情境练习都看完了。新的在午夜开放，看过的随时可以重看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
