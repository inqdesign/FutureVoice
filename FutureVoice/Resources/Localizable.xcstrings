    "Nothing is lost by putting this off — no streak breaks and today still counts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufschieben kostet dich nichts – keine Serie reißt, und der Tag zählt weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pierdes nada por dejarlo para después: la racha no se rompe y hoy sigue contando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne perds rien à remettre ça à plus tard : la série tient et la journée compte quand même."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後回しにしても失うものはありません。連続記録も途切れず、今日もそのまま数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미뤄도 잃는 건 없어요. 연속 기록도 안 끊기고, 오늘도 그대로 인정돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先放着也不会损失什么。连续天数不会中断，今天照样算数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先放著也不會損失什麼。連續天數不會中斷，今天照樣算數。"
          }
        }
      }
    },
