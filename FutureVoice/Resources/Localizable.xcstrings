    "I'm practicing speaking with my own AI voice on nawana. Enter my code %@ when you sign up and we both get %lld minutes of talk time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I'm practicing speaking with my own AI voice on nawana. Enter my code %1$@ when you sign up and we both get %2$lld minutes of talk time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawanaで自分の声を使って話す練習をしています。登録するときにコード%1$@を入力すると、ふたりとも通話時間が%2$lld分もらえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nawana에서 내 목소리로 말하기 연습하고 있어요. 가입할 때 코드 %@ 를 넣으면 둘 다 통화 %lld분을 받아요."
          }
