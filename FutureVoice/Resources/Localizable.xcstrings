    "%lld seats. One opens only when the person in it stops — never because someone new arrived." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Plätze. Einer wird nur frei, wenn die Person darauf aufhört — nie, weil jemand Neues kommt."
