      }
    },
    "Your %@": {},
    "Your CEFR level shapes each conversation. The daily goal drives the ring on Home.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CEFR 레벨이 대화의 난이도를 정하고, 하루 목표가 홈 화면의 링을 채웁니다."
          }
        }
      }
    },
    "Your answers go straight to the team building nawana.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남기신 답변은 nawana를 만드는 팀에게 바로 전달돼요."
          }
        }
      }
    },
    "Your cloned voice already speaks %@ — no new recording needed. Your %@ progress stays untouched.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your cloned voice already speaks %1$@ — no new recording needed. Your %2$@ progress stays untouched."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클론된 목소리는 이미 %1$@를 할 줄 알아서 다시 녹음할 필요가 없어요. 기존 %2$@ 진행 상황도 그대로 유지됩니다."
          }
        }
      }
    },
    "Your cloned voice speaks every language you add. Removing one keeps its progress — re-add it anytime.": {
      "extractionState": "stale",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클론된 목소리는 추가한 모든 언어를 말합니다. 언어를 빼도 진행 상황은 남아서 언제든 다시 추가할 수 있어요."
          }
        }
      }
    },
    "Your code": {},
    "Your current clone will be deleted on ElevenLabs after the new one is created.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 클론이 만들어진 뒤 기존 클론은 ElevenLabs에서 삭제돼요."
