    },
    "The words, the expressions, the lines you actually spoke — bound into a book you flip through, shadow and keep." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際に話した単語と表現、文が一冊にまとまります。めくって、シャドーイングして、ずっと持っていけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내가 실제로 말한 단어와 표현, 문장이 한 권으로 묶여요. 넘겨 보고, 따라 말하고, 계속 가져가요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
