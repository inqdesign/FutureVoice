    "Words, expressions, sentences. Everything you say joins a world that's yours — automatically." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palabras, expresiones, frases. Todo lo que dices se va acumulando como tuyo, solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mots, expressions, phrases. Tout ce que tu dis vient s’ajouter à un monde qui est le tien — tout seul."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語も、表現も、文も。話したことが自然と自分のものとして積み上がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어도, 표현도, 문장도. 말한 것들이 알아서 내 것으로 쌓여요."
          }
