          }
        }
      }
    },
    "Replaces your current voice. Your recording is kept, so you can rebuild the original anytime from Me → Voice.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt deine aktuelle Stimme. Deine Aufnahme bleibt erhalten — du kannst das Original jederzeit unter Me → Voice neu erstellen."
