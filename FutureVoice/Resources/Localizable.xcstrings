    "Shadow any line, get a real score, watch the weekly trend." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz shadowing de cualquier frase, recibe una puntuación real y mira la tendencia semanal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais du shadowing sur n’importe quelle phrase, reçois un vrai score et suis la tendance de la semaine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの文でもシャドーイングして、実際のスコアと週ごとの推移を確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 문장이든 섀도잉하고 실제 점수와 주간 추이를 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何句子都能跟读，拿到真实分数，看每周的变化。"
