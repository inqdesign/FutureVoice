          }
        }
      }
    },
    "You're in line. A seat opens when someone stops." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "順番待ちに並んでいます。誰かがやめると席が空きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
