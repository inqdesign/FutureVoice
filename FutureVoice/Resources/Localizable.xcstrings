    "Today's talk minutes are used up — they reset at midnight. This call is saved; pick it up tomorrow." : {
      "comment" : "Error message explaining that a user's free talk minutes have run out for the day, but the call is still saved and can be resumed tomorrow.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprechminuten für heute sind aufgebraucht — um Mitternacht gibt es neue. Dieses Gespräch ist gespeichert; mach morgen weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has usado el tiempo de conversación de hoy — se renueva a medianoche. Esta llamada está guardada; retómala mañana."
