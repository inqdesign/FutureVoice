        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 빠지면 날짜가 하루 밀려요. 처음부터 다시는 아니고요."
          }
        }
      }
    },
    "A new assessment is due — it runs after your next talk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
