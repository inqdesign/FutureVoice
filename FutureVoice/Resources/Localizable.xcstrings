        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@와의 관계를 바탕으로 만들었어요. 상황연습 탭에서 이 사람을 누르면 아이디어로 나와요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
