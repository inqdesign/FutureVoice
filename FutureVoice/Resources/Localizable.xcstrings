        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade a alguien de tu vida real: con su voz clonada puede interpretar cualquier situación que crees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute quelqu’un de ta vraie vie — son clone vocal peut jouer n’importe quelle situation que tu crées."
          }
