    "Scenes refill at the start of each billing period." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las escenas se renuevan al empezar cada periodo de facturación."
          }
        },
