    "Enter a friend's code once for about an hour of bonus talk time.": {},
    "Enter a friend's code once to get 300 bonus credits.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einmal den Code eines Freundes ein und erhalte 300 Bonus-Credits."
