          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans limite et sans rationnement. Parler demande un vrai effort : il n’y a rien à rationner ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限も、節約する必要もありません。話すのには本当に力がいるからです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제한도, 아껴 쓸 일도 없어요. 말하는 데는 실제로 힘이 들어가니까요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有上限，也不用省着用。说话本来就要花力气。"
