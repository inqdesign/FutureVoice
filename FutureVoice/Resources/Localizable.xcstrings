    "Repeat your fluent self's lines from this talk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich die Sätze deines fließenden Ichs aus diesem Gespräch nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite las frases que dijo tu yo fluido en esta llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répète les phrases de ton moi fluide dans cet appel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この通話で流暢な自分が言ったセリフを、まねして言ってみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화에서 유창해진 내가 한 말을 따라 말해 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟着念这通电话里流利的自己说过的话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟著唸這通電話裡流利的自己說過的話。"
          }
        }
      }
    },
    "Replace your current clone with a new one" : {
      "localizations" : {
        "es" : {
