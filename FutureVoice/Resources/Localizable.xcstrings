    },
    "You're in line, and there's room. You take a seat tonight." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "順番待ちに並んでいて、席も空いています。今夜、席に着きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
