    "Not their real voice — an AI speaks their words in a voice you pick." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人の声ではありません。選んだ声で、AIがこの人の言葉を読みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
