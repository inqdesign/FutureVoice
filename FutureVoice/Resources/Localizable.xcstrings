    },
    "You've been back for another call. Two quick questions, and anything you want to say." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has vuelto para otra llamada. Dos preguntas rápidas y lo que quieras contarme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es revenu pour un autre appel. Deux questions rapides, et tout ce que tu veux dire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "また戻ってきて話してくれましたね。短い質問が二つと、言いたいことがあれば何でも。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 돌아와서 또 통화하셨네요. 짧게 두 가지만, 그리고 하고 싶은 말 아무거나요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你又回来通话了。想问两个小问题，还有任何你想说的话。"
