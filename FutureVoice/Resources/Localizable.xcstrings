        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 위에 내 녹음을 겹쳐서, 둘 다 첫 단어에서 시작해요. 어디서부터 밀리는지 들어보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你的录音叠在范本上，两边都从第一个词开始。听听看你是从哪里开始落后的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你的錄音疊在範本上，兩邊都從第一個字開始。聽聽看你是從哪裡開始落後的。"
          }
        }
      }
    },
    "Your talk time is used up. This call is saved — you can pick it up again any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
