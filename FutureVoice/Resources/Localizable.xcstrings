    "Write to us to see or correct what we hold about you, including the date you gave consent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib uns, um einzusehen oder zu korrigieren, was wir über dich gespeichert haben – einschließlich des Datums deiner Einwilligung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbenos para ver o corregir lo que guardamos sobre ti, incluida la fecha en que diste tu consentimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écris-nous pour voir ou corriger ce que nous gardons sur toi, y compris la date de ton consentement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意した日付を含め、保管中の情報の確認や修正はお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동의한 날짜를 비롯해 보관 중인 내 정보를 확인하거나 고치고 싶으면 문의해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想确认或修改我们保存的数据（包含同意日期），请来信告诉我们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想確認或修改我們保存的資料（包含同意日期），請來信告訴我們。"
          }
        }
      }
    },
