          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca lo que encaje: con esto elegimos tus noticias y sacamos temas de conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche ce qui te correspond : on choisit tes actus là-dedans, et on y prend aussi de quoi parler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当てはまるものを選びましょう。ここで選んだものからニュースの話題を選び、会話のネタもここから取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당되는 걸 골라요. 여기서 고른 걸로 뉴스 주제를 뽑고, 대화 소재도 여기서 가져와요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选符合的。新闻主题会从这里挑，对话的话题也从这里来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選符合的。新聞主題會從這裡挑，對話的話題也從這裡來。"
          }
        }
      }
    },
