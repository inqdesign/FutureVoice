    "%lld seats. One opens only when the person in it stops — never because someone new arrived." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Plätze. Einer wird nur frei, wenn die Person darauf aufhört — nie, weil jemand Neues kommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld plazas. Una se libera solo cuando quien la ocupa lo deja, nunca porque llegue alguien nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld places. Une place se libère seulement quand la personne assise arrête — jamais parce que quelqu’un de nouveau arrive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld席。空くのは座っている人がやめたときだけ。新しく来た人のために誰かを押し出すことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld자리. 앉은 사람이 그만둬야 자리가 나요. 새로 왔다고 누굴 밀어내지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld席。只有坐着的人停下来，席位才会空出来。不会因为有新人来就把谁挤出去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld席。只有坐著的人停下來，席位才會空出來。不會因為有新人來就把誰擠出去。"
          }
        }
      }
    },
