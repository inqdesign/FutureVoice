      }
    },
    "A missed day pushes your date back by one. Nothing resets to zero." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein verpasster Tag verschiebt dein Datum um einen Tag. Nichts wird zurückgesetzt."
