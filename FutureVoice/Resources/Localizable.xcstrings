            "state": "translated",
            "value": "Tippen zum Aufdecken"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눌러서 보기"
          }
        }
      }
    },
    "Tap to talk": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sprechen tippen"
          }
        },
        "ko": {
