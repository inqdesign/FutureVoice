          }
        }
      }
    },
    "Not happy with a take? You can re-record." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Aufnahme unzufrieden? Du kannst sie wiederholen."
