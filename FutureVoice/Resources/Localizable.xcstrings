          }
        }
      }
    },
    "Distinct graded words you've used, accumulating from the day each was first said." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiedene eingestufte Wörter, die du verwendet hast — gezählt ab dem Tag, an dem du sie zuerst gesagt hast."
