    },
    "Nothing is lost by putting this off — no streak breaks and today still counts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufschieben kostet dich nichts – keine Serie reißt, und der Tag zählt weiterhin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미뤄도 잃는 건 없습니다 — 연속 기록도 안 끊기고, 오늘도 그대로 인정됩니다."
          }
        }
      }
    },
    "Nothing to shadow yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zum Nachsprechen"
