    "Pick a time and the phone rings. Miss it, and a voicemail with a question waits for you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la hora que elijas, el teléfono suena. Si no contestas, te espera un mensaje de voz con una pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l’heure que tu choisis, le téléphone sonne. Si tu ne réponds pas, un message vocal avec une question t’attend."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決めた時間に、流暢な自分から電話がかかってきます。出られなかったら、質問入りの留守番メッセージが待っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정해둔 시간에 유창해진 내가 전화를 걸어요. 못 받으면 질문이 담긴 음성 메시지가 기다려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到了设置的时间，流利的自己会打电话来。没接到的话，会有一则带着问题的语音留言等你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到了設定的時間，流利的自己會打電話來。沒接到的話，會有一則帶著問題的語音留言等你。"
          }
        }
      }
    },
    "Pick a voice, or one of your people to have them play the scene as themselves." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
