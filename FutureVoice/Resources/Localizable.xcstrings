        }
      }
    },
    "Assessed %@ — a while back. Your next talks feed a fresh assessment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingestuft %@ — schon eine Weile her. Deine nächsten Gespräche fließen in eine neue Einstufung ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evaluado el %@ — hace ya un tiempo. Tus próximas llamadas alimentan una evaluación nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évalué le %@ — ça commence à dater. Tes prochains appels alimentent une nouvelle évaluation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に判定しました。だいぶ前ですね。これからの通話が新しい判定に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 평가했어요 — 꽤 지났네요. 다음 대화들이 새 평가에 반영돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在%@评估过，已经有一阵子了。接下来的通话会用来重新评估。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在%@評估過，已經有一陣子了。接下來的通話會用來重新評估。"
          }
        }
      }
    },
    "Assessed %@ from your recent talk — vocabulary, grammar, fluency and expression together." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingestuft %@ anhand deiner letzten Gespräche — Wortschatz, Grammatik, Flüssigkeit und Ausdruck zusammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evaluado el %@ a partir de tu última llamada — vocabulario, gramática, fluidez y expresión juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évalué le %@ à partir de ton dernier appel — vocabulaire, grammaire, fluidité et expression ensemble."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に最近の通話から判定しました。語彙・文法・流暢さ・表現をまとめて見ています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 최근 대화로 평가했어요. 어휘·문법·유창성·표현을 함께 봤어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在%@根据最近的通话评估过，词汇、语法、流利度和表达一起看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在%@根據最近的通話評估過，字彙、文法、流利度和表達一起看。"
          }
        }
      }
    },
