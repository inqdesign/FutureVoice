          }
        }
      }
    },
    "Clears setup, voice clone and persona, then restarts the first-run flow. You stay signed in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Setup, Stimmklon und Persona und startet den Erstlauf neu. Du bleibst angemeldet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定と声、プロフィールを消して、初回起動の画面からやり直します。ログインはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정과 목소리, 프로필을 지우고 처음 켰을 때 화면부터 다시 시작해요. 로그인은 그대로예요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除設定、聲音和個人檔案，從第一次開啟的畫面重新開始。登入狀態不變。"
