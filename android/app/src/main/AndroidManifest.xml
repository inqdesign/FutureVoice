<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- HapticEngine drives the vibrator directly (One UI turns every
         performHapticFeedback constant into a long buzz). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Speech tab: the front camera for a take, asked only when the camera is on. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The day card's "Save to Photos" (iOS `704cc4a`): API 29+ inserts
         through MediaStore with no permission; only Android 8–9 need this. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- A live call holds the mic and a socket; without a foreground service
         Android 14+ takes both the moment the screen locks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The daily call IS an alarm-clock use (Play declaration: alarm). -->
    <!-- SCHEDULE_EXACT_ALARM, not USE_EXACT_ALARM: Play restricts the latter
         to alarm-clock, timer and calendar apps, and a language app that
         declares it has its release rejected. This one the learner grants,
         and DailyCallScheduler falls back to an inexact window without it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- SpeechRecognizer lives in another process; package visibility (API 30+)
         requires declaring the intent we resolve against. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".FutureVoiceApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FutureVoice">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FutureVoice">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth callback + widget/notification deep links.
                 Same scheme as iOS: futurevoice:// -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="futurevoice" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The daily call's ring on the alarm stream (rings through silent mode). -->
        <service
            android:name=".data.DailyCallRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".talk.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <receiver
            android:name=".data.DailyCallReceiver"
            android:exported="false" />

        <!-- "Can't talk now" on the ring — settles the call without opening the app. -->
        <receiver
            android:name=".data.DailyCallDeclineReceiver"
            android:exported="false" />

        <!-- A word coming back. Separate from the daily call's receiver on
             purpose: the call is the habit anchor and rings; this only ever
             posts a quiet notification. -->
        <receiver
            android:name=".data.ReviewDueReceiver"
            android:exported="false" />
<receiver
            android:name=".data.DrillDueReceiver"
            android:exported="false" />

        <!-- A routine block's own reminder (say it again), rebuilt from the plan. -->
        <receiver
            android:name=".data.PlanReminderReceiver"
            android:exported="false" />

        <!-- The week's test opening (Practice → goals → Remind me). -->
        <receiver
            android:name=".data.WeeklyTestReminderReceiver"
            android:exported="false" />

        <!-- The trial notice the paywall promises. -->
        <receiver
            android:name=".data.TrialEndingReceiver"
            android:exported="false" />

        <!-- Two widgets, one per section — the app writes their snapshots,
             the widgets only read them. -->
        <receiver
            android:name=".widget.WordsWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_words_info" />
        </receiver>

        <receiver
            android:name=".widget.ExpressionsWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_expressions_info" />
        </receiver>

        <!-- The other four (iOS StudyWidget.swift, plan 4.7): streak, the book
             in progress, today's progress, and one-tap free talk. -->
        <receiver
            android:name=".widget.StreakWidgetReceiver"
            android:label="@string/streak"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>

        <receiver
            android:name=".widget.BookWidgetReceiver"
            android:label="@string/widget_continue_studying"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_book_info" />
        </receiver>

        <receiver
            android:name=".widget.ProgressWidgetReceiver"
            android:label="@string/progress"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_progress_info" />
        </receiver>

        <receiver
            android:name=".widget.FreeTalkWidgetReceiver"
            android:label="@string/free_talk"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_freetalk_info" />
        </receiver>
    </application>
</manifest>
