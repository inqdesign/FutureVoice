<?xml version="1.0" encoding="utf-8"?>
<!-- The streak widget's live countdown to midnight (iOS `Text(timerInterval:)`).
     Glance has no timer, so it is a RemoteViews Chronometer ticking on its own. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="monospace"
    android:maxLines="1"
    android:textColor="#D9FFFFFF"
    android:textSize="12sp" />
