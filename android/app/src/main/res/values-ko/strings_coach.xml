<!-- Coach mode 1.1.4 (iOS 6e9eb92 + eaaf3af): the practice call and the
     first-call check. Values copied from the iOS catalog at ebf848e. -->
<resources>
    <string name="practice_call">연습 대화</string>
    <string name="practice_call_note">예시 문장을 보면서 연습한 대화예요. 레벨은 코치 모드 없이 한 대화로 측정해요.</string>
    <string name="fcc_title">첫 대화 어땠어요?</string>
    <string name="fcc_you_picked">고른 레벨: %1$s</string>
    <string name="fcc_easy">쉬웠어요</string>
    <string name="fcc_just_right">딱 좋았어요</string>
    <string name="fcc_hard">어려웠어요</string>
    <string name="fcc_your_level">내 레벨</string>
    <string name="fcc_speed_footer">다음 대화부터 미래의 내가 이 속도로 말해요.</string>
    <string name="fcc_coach_footer">생각하는 동안 마이크 위에 말해 볼 문장이 떠요. 흐린 부분만 내 이야기로 바꿔 말하면 돼요. 코치 모드 대화는 연습이라 레벨 측정에는 들어가지 않아요.</string>
    <string name="fcc_set_hard">아래 설정을 한 단계 쉬운 레벨, 느린 목소리, 코치 모드로 바꿔 뒀어요. 저장하기 전에 얼마든지 바꿀 수 있어요.</string>
    <string name="fcc_set_easy">아래 설정을 한 단계 높은 레벨, 코치 모드 끔으로 바꿔 뒀어요. 저장하기 전에 얼마든지 바꿀 수 있어요.</string>
    <string name="fcc_set_right">좋아요! 그대로 두거나, 아래에서 바꿔 보세요.</string>
</resources>
