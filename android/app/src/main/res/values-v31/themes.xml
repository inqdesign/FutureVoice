<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws a splash from these before the first frame: made to
         match the iOS launch screen (the mark alone, no circle, on white /
         black) instead of the launcher icon in a disc. -->
    <style name="Theme.FutureVoice" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>
</resources>
