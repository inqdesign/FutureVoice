# Copy to android/local.properties (gitignored) and fill in.
# Mirror of iOS's Config/FutureVoice.xcconfig — only Supabase values are
# needed; provider keys live server-side in Edge Functions.
#
# sdk.dir is written automatically by Android Studio; set it by hand for
# command-line builds.

sdk.dir=/Users/<you>/Library/Android/sdk

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google sign-in (roadmap §4.2): the WEB OAuth client id from the owner's
# Google Cloud project. Leave empty until it exists; the button hides itself.
GOOGLE_WEB_CLIENT_ID=
