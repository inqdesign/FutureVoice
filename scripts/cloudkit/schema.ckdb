DEFINE SCHEMA

    RECORD TYPE Blob (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "asset"         ASSET,
        "deletedAt"     TIMESTAMP,
        "key"           STRING,
        "kind"          STRING,
        "lang"          STRING,
        "modifiedAt"    TIMESTAMP,
        "schema"        INT64,
        "size"          INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Item (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "deletedAt"     TIMESTAMP,
        "key"           STRING,
        "kind"          STRING,
        "lang"          STRING,
        "modifiedAt"    TIMESTAMP,
        "payload"       BYTES,
        "payloadAsset"  ASSET,
        "schema"        INT64,
        "size"          INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "roles"         LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
