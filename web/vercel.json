{
  "rewrites": [
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/community/",
      "destination": "/community.html"
    },
    {
      "source": "/creators",
      "destination": "/creators.html"
    },
    {
      "source": "/creators/",
      "destination": "/creators.html"
    },
    {
      "source": "/en/creators",
      "destination": "/en/creators.html"
    },
    {
      "source": "/en/creators/",
      "destination": "/en/creators.html"
    },
    {
      "source": "/pay",
      "destination": "/creators-pay.html"
    },
    {
      "source": "/s/:survey",
      "destination": "/survey.html"
    },
    {
      "source": "/admin",
      "destination": "https://nawana-admin.futurevoice-gateway.workers.dev/admin"
    },
    {
      "source": "/admin/",
      "destination": "https://nawana-admin.futurevoice-gateway.workers.dev/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://nawana-admin.futurevoice-gateway.workers.dev/admin/:path*"
    }
  ]
}
