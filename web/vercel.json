{
  "rewrites": [
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/community/",
      "destination": "/community.html"
    },
    {
      "source": "/admin",
      "destination": "https://nawana-admin.futurevoice-gateway.workers.dev/admin"
    },
    {
      "source": "/admin/",
      "destination": "https://nawana-admin.futurevoice-gateway.workers.dev/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://nawana-admin.futurevoice-gateway.workers.dev/admin/:path*"
    }
  ]
}
